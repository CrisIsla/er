  "erDoc": "entity Cliente {\n  rut key\n  nombre\n  email\n}\n\nentity Socio extends Cliente {\n  puntos\n}\n\nentity Invitado extends Cliente {}\n\nentity Estudiante extends Cliente {}\n\nentity Senior extends Cliente {}\n\nentity Vip extends Cliente {}\n\nentity Empleado {\n  rut key\n  nombre\n  cargo\n}\n\nentity Turno {\n  codigo key\n  horario\n}\n\nentity Cine {\n  codigo key\n  nombre\n  ciudad\n}\n\nentity Sala {\n  numero key\n  aforo\n}\n\nentity Pelicula {\n  titulo key\n  anio\n  duracion\n}\n\nentity Director {\n  rut key\n  nombre\n  pais\n}\n\nentity Genero {\n  nombre key\n}\n\nentity Producto {\n  codigo key\n  nombre\n  precio\n}\n\nentity Proveedor {\n  rut key\n  nombre\n}\n\nrelation Tiene(Cine 1, Sala N!)\n\nrelation Proyecta(Sala, Pelicula) {\n  horario\n}\n\naggregation Funcion(Proyecta)\n\nrelation Compra(Cliente, Funcion) {\n  asiento\n  precio\n}\n\nrelation Dirige(Director, Pelicula)\n\nrelation Pertenece(Pelicula, Genero)\n\nrelation Vende(Empleado, Producto) {\n  cantidad\n}\n\nrelation Trabaja(Empleado, Cine, Turno) {\n  desde\n}\n\nrelation Provee(Proveedor, Producto)\n",
