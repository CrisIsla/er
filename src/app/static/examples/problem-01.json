  "erDoc": "entity Alumno {\n  rut key\n  nombre\n  fono\n  edad\n}\n\nentity Docente {\n  rut key\n  nombre\n  sueldo\n}\n\nentity Tutor extends Docente {\n  turno\n}\n\nentity Curso {\n  codigo key\n  nivel\n}\n\nentity Libro {\n  codigo key\n  titulo\n  autor\n}\n\nentity Prueba {\n  codigo key\n  tipo\n  nota\n}\n\nentity Taller {\n  codigo key\n  nombre\n  cupo\n}\n\nentity Sala {\n  numero key\n  piso\n}\n\nentity Aula {\n  numero key\n  piso\n}\n\nentity Pupitre depends on Ubicado {\n  numero pkey\n  fila\n}\n\nrelation Dicta(Docente, Curso) {\n  horas\n}\n\nrelation Cursa(Alumno, Curso 1!)\n\nrelation Presta(Docente, Alumno, Libro) {\n  fecha\n}\n\nrelation Dirige(Tutor, Taller) {\n  hora\n}\n\nrelation Rinde(Alumno, Prueba) {\n  fecha\n}\n\nrelation Asiste(Alumno, Taller)\n\nrelation Usa(Taller, Sala)\n\nrelation Ocupa(Alumno 1, Pupitre 1) {\n  desde\n}\n\nrelation Ubicado(Aula, Pupitre 1!)\n",
